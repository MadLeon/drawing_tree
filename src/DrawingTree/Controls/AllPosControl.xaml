<UserControl x:Class="DrawingTree.Controls.AllPosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DrawingTree.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <Geometry x:Key="OpenInNewGeo">M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z</Geometry>
        <Geometry x:Key="CheckCircleGeo">M382-240 154-468l57-57 171 171 367-367 57 57-424 424Zm98 160q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</Geometry>

        <Style x:Key="HeaderCell" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="BodyCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Read-only TextBox styled as plain text — for OE DataGrid cells -->
        <Style x:Key="SelectableCell" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Read-only TextBox styled as plain text — for Simple View fields -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar: [Title | Search | Buttons] -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title + count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" Text="All Purchase Orders"
                               FontSize="13" FontWeight="SemiBold" Foreground="#555555"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PoCountLabel" Text=""
                               FontSize="12" Foreground="#888888"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: search bar (same style as SearchControl) -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="PoSearchBox"
                             Height="28" Padding="5,4" FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="PoSearchBox_TextChanged"/>
                    <TextBlock x:Name="PoPlaceholderText"
                               Text="Search PO / Job / Drawing"
                               IsHitTestVisible="False"
                               Foreground="#AAAAAA" FontSize="13"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Right: buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="NewJobButton" Content="New Job"
                            Style="{StaticResource ToolbarBtn}"
                            Click="NewJobButton_Click"/>
                    <Button x:Name="HistoryButton" Content="History Orders"
                            Style="{StaticResource ToolbarBtn}"
                            Click="HistoryButton_Click"/>
                    <Button x:Name="ToggleViewButton" Content="OE View"
                            Style="{StaticResource ToolbarBtn}"
                            Click="ToggleViewButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1" x:Name="ContentGrid">

            <local:LoadingOverlayControl x:Name="LoadingOverlay"
                                         Visibility="Collapsed" Panel.ZIndex="10"/>

            <!-- ── OE View ─────────────────────────────────────────────────── -->
            <DataGrid x:Name="ResultsGrid"
                      VirtualizingPanel.IsVirtualizing="False"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      ColumnHeaderStyle="{StaticResource HeaderCell}"
                      CellStyle="{StaticResource BodyCell}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <StackPanel>
                                                <Border Height="12" Background="Transparent"/>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>

                    <!-- P.O. — searchable, toggle TextBox/TextBlock -->
                    <DataGridTemplateColumn Header="P.O." Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding PoNumber, Mode=OneWay}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock local:HighlightBehavior.FullText="{Binding PoNumber}"
                                               local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                               VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- O.E. — searchable -->
                    <DataGridTemplateColumn Header="O.E." Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding OeNumber, Mode=OneWay}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock local:HighlightBehavior.FullText="{Binding OeNumber}"
                                               local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                               VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Job No — searchable -->
                    <DataGridTemplateColumn Header="Job No" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding JobNumber, Mode=OneWay}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock local:HighlightBehavior.FullText="{Binding JobNumber}"
                                               local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                               VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Line No — not searchable, plain TextBox -->
                    <DataGridTemplateColumn Header="Line No" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LineNumber, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Customer — searchable -->
                    <DataGridTemplateColumn Header="Customer" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding CustomerName, Mode=OneWay}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock local:HighlightBehavior.FullText="{Binding CustomerName}"
                                               local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                               VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Contact — plain TextBox -->
                    <DataGridTemplateColumn Header="Contact" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ContactName, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Qty — plain TextBox -->
                    <DataGridTemplateColumn Header="Qty" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Quantity, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Drawing Number — searchable -->
                    <DataGridTemplateColumn Header="Drawing Number" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding DrawingNumber, Mode=OneWay}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock local:HighlightBehavior.FullText="{Binding DrawingNumber}"
                                               local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                               VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Rev. — plain TextBox -->
                    <DataGridTemplateColumn Header="Rev." Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Revision, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Description — searchable, with trimming/tooltip -->
                    <DataGridTemplateColumn Header="Description" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Text="{Binding Description, Mode=OneWay}"
                                             ToolTip="{Binding Description}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock local:HighlightBehavior.FullText="{Binding Description}"
                                               local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}"
                                               VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Rls Date — plain TextBox -->
                    <DataGridTemplateColumn Header="Rls Date" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReleaseDate, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Due Date — plain TextBox -->
                    <DataGridTemplateColumn Header="Due Date" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DueDate, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Row menu -->
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⋮" FontSize="14" Style="{StaticResource IconLinkBtn}"
                                        Tag="{Binding}" Click="OeRowMenu_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit Item" Click="EditItem_ContextMenu_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Simple View ────────────────────────────────────────────── -->
            <ScrollViewer x:Name="SimpleViewScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ItemsControl x:Name="SimpleViewList" Background="White">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PoSimpleGroup}">
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,8,0,0">

                                <!-- PO header row -->
                                <StackPanel>
                                    <Border Background="#F0F4F8" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Margin="0,0,16,0" FontSize="12" FontWeight="SemiBold" Foreground="#1A237E">
                                                    <Run Text="PO: "/><Run Text="{Binding PoNumber}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555">
                                                    <Run Text="OE: "/><Run Text="{Binding OeNumber}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555">
                                                    <Run Text="Customer: "/><Run Text="{Binding CustomerName}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="#555">
                                                    <Run Text="Contact: "/><Run Text="{Binding ContactName}"/>
                                                </TextBlock>
                                            </WrapPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tree" Height="24" FontSize="11"
                                                        Margin="0,0,4,0" Padding="8,0"
                                                        Tag="{Binding}" Click="SimplePoTreeButton_Click"/>
                                                <Button Content="Package Tracker" Height="24" FontSize="11"
                                                        Margin="0,0,4,0" Padding="8,0"
                                                        Tag="{Binding PoId}" Click="SimplePoDetailButton_Click"/>
                                                <Button Content="⋮" FontSize="14" Style="{StaticResource IconLinkBtn}"
                                                        Tag="{Binding}" Click="PoHeaderMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Mark As Shipped" Tag="{Binding PoId}"
                                                                      Click="MarkAsShipped_Click"/>
                                                            <MenuItem Header="Input Data" Tag="{Binding PoNumber}"
                                                                      Click="InputData_Click"/>
                                                            <MenuItem Header="Edit Parts"
                                                                      Click="EditParts_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Column header row -->
                                    <Border Background="#E8EAF0" Padding="0,3">
                                        <Grid MinWidth="940">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Job"            FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="Ln"             FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="3" Text="Qty"            FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="4" Text="Drawing Number" FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="5" Text="Description"    FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="6" Text="PDF"            FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="7" Text="MP"             FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="8" Text="DIR"            FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="9" Text="Rls Date"       FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="10" Text="Due Date"      FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Order item rows -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ExpandableOrderItem}">
                                                <StackPanel>
                                                    <!-- Main row -->
                                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"
                                                            Padding="0,3">
                                                        <Grid MinWidth="940">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Expand icon -->
                                                            <Button Grid.Column="0"
                                                                    Width="18" Height="18"
                                                                    Style="{StaticResource IconLinkBtn}"
                                                                    Padding="0"
                                                                    Visibility="{Binding ExpandButtonVisibility}"
                                                                    Tag="{Binding}"
                                                                    Click="ExpandItem_Click">
                                                                <Path Stretch="Uniform" Fill="#555555" Width="12" Height="12"
                                                                      Data="{Binding ExpandIconGeometry}"/>
                                                            </Button>
                                                            <!-- Job number — selectable -->
                                                            <TextBox Grid.Column="1" Text="{Binding Row.JobNumber, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Line number — selectable -->
                                                            <TextBox Grid.Column="2" Text="{Binding Row.LineNumber, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Qty — selectable -->
                                                            <TextBox Grid.Column="3" Text="{Binding Row.Quantity, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Drawing Number — link TextBlock with HorizontalAlignment=Left to fix click area -->
                                                            <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                                                       HorizontalAlignment="Left"
                                                                       Foreground="{Binding DrawingLinkForeground}"
                                                                       TextDecorations="{Binding DrawingLinkDecorations}"
                                                                       Cursor="{Binding DrawingLinkCursor}"
                                                                       Tag="{Binding}"
                                                                       MouseLeftButtonDown="DrawingNumberMain_Click"
                                                                       local:HighlightBehavior.FullText="{Binding Row.DrawingNumber}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}">
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>
                                                            <!-- Description — toggle TextBox/TextBlock for selection + highlight -->
                                                            <Grid Grid.Column="5">
                                                                <TextBox Text="{Binding Row.Description, Mode=OneWay}"
                                                                         ToolTip="{Binding Row.Description}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock local:HighlightBehavior.FullText="{Binding Row.Description}"
                                                                           local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Row.Description}"
                                                                           VerticalAlignment="Center" Margin="4,0" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <TextBlock.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                        </ContextMenu>
                                                                    </TextBlock.ContextMenu>
                                                                </TextBlock>
                                                            </Grid>
                                                            <!-- PDF button -->
                                                            <Button Grid.Column="6"
                                                                    Visibility="{Binding PartButtonVisibility}"
                                                                    Tag="{Binding}" Click="OpenPartButton_Click"
                                                                    Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    ToolTip="Open PDF">
                                                                <Viewbox Width="13" Height="13">
                                                                    <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="DodgerBlue"/>
                                                                </Viewbox>
                                                            </Button>
                                                            <!-- MP icon -->
                                                            <Viewbox Grid.Column="7" Width="14" Height="14"
                                                                     Visibility="{Binding MpIconVisibility}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                            </Viewbox>
                                                            <!-- DIR icon -->
                                                            <Viewbox Grid.Column="8" Width="14" Height="14"
                                                                     Visibility="{Binding DirIconVisibility}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                            </Viewbox>
                                                            <!-- Rls Date — selectable -->
                                                            <TextBox Grid.Column="9" Text="{Binding Row.ReleaseDate, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Due Date — selectable -->
                                                            <TextBox Grid.Column="10" Text="{Binding Row.DueDate, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Row menu -->
                                                            <Button Grid.Column="11" Content="⋮" FontSize="14"
                                                                    Style="{StaticResource IconLinkBtn}"
                                                                    Tag="{Binding}" Click="ItemRowMenu_Click">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Edit Item"
                                                                                  Click="EditItem_ContextMenu_Click"/>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Child rows (shown when expanded) -->
                                                    <ItemsControl ItemsSource="{Binding Children}"
                                                                  Visibility="{Binding ChildrenVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:ChildDrawingItem}">
                                                                <Border Background="#FAFAFA"
                                                                        BorderBrush="#EEEEEE"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,3">
                                                                    <Grid MinWidth="940">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="24"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="200"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Drawing Number — link TextBlock with HorizontalAlignment=Left -->
                                                                        <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                                                                   HorizontalAlignment="Left"
                                                                                   Foreground="{Binding DrawingLinkForeground}"
                                                                                   TextDecorations="{Binding DrawingLinkDecorations}"
                                                                                   Cursor="{Binding DrawingLinkCursor}"
                                                                                   Tag="{Binding}"
                                                                                   MouseLeftButtonDown="DrawingNumberChild_Click"
                                                                                   local:HighlightBehavior.FullText="{Binding DrawingNumber}"
                                                                                   local:HighlightBehavior.SearchTerm="{Binding SearchTerm}">
                                                                            <TextBlock.ContextMenu>
                                                                                <ContextMenu>
                                                                                    <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                                </ContextMenu>
                                                                            </TextBlock.ContextMenu>
                                                                        </TextBlock>
                                                                        <!-- Description — selectable TextBox -->
                                                                        <TextBox Grid.Column="5" Text="{Binding Description, Mode=OneWay}"
                                                                                 Style="{StaticResource SelectableText}"/>
                                                                        <!-- PDF button -->
                                                                        <Button Grid.Column="6"
                                                                                Visibility="{Binding PdfButtonVisibility}"
                                                                                Tag="{Binding}" Click="OpenChildPdfButton_Click"
                                                                                Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                ToolTip="Open PDF">
                                                                            <Viewbox Width="13" Height="13">
                                                                                <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="DodgerBlue"/>
                                                                            </Viewbox>
                                                                        </Button>
                                                                        <!-- MP icon -->
                                                                        <Viewbox Grid.Column="7" Width="14" Height="14"
                                                                                 Visibility="{Binding MpIconVisibility}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                                        </Viewbox>
                                                                        <!-- DIR icon -->
                                                                        <Viewbox Grid.Column="8" Width="14" Height="14"
                                                                                 Visibility="{Binding DirIconVisibility}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                                        </Viewbox>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
