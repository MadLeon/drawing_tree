<UserControl x:Class="DrawingTree.Controls.AllPosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="HeaderCell" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="BodyCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}"/>
                    <Setter Property="Foreground" Value="{x:Static SystemColors.HighlightTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="8,6">
            <TextBlock Text="All Purchase Orders" FontSize="13" FontWeight="SemiBold"
                       Foreground="#555555" VerticalAlignment="Center"/>
        </Border>

        <!-- PO lines DataGrid -->
        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE"
                  BorderThickness="0"
                  RowBackground="White"
                  AlternatingRowBackground="White"
                  ColumnHeaderStyle="{StaticResource HeaderCell}"
                  CellStyle="{StaticResource BodyCell}">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            <Border Height="12" Background="Transparent"/>
                                            <ItemsPresenter/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="P.O."
                                    Binding="{Binding PoNumber}"
                                    Width="200"/>
                <DataGridTextColumn Header="O.E."
                                    Binding="{Binding OeNumber}"
                                    Width="70"/>
                <DataGridTextColumn Header="Job No"
                                    Binding="{Binding JobNumber}"
                                    Width="100"/>
                <DataGridTextColumn Header="Line No"
                                    Binding="{Binding LineNumber}"
                                    Width="70"/>
                <DataGridTextColumn Header="Customer"
                                    Binding="{Binding CustomerName}"
                                    Width="140"/>
                <DataGridTextColumn Header="Contact"
                                    Binding="{Binding ContactName}"
                                    Width="160"/>
                <DataGridTextColumn Header="Qty"
                                    Binding="{Binding Quantity}"
                                    Width="60"/>
                <DataGridTextColumn Header="Drawing Number"
                                    Binding="{Binding DrawingNumber}"
                                    Width="220"/>
                <DataGridTextColumn Header="Rev."
                                    Binding="{Binding Revision}"
                                    Width="60"/>
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Rls Date"
                                    Binding="{Binding ReleaseDate}"
                                    Width="100"/>
                <DataGridTextColumn Header="Due Date"
                                    Binding="{Binding DueDate}"
                                    Width="100"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="View"
                                    Height="24" FontSize="11"
                                    Margin="4,2"
                                    Tag="{Binding PoId}"
                                    Click="ViewButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
