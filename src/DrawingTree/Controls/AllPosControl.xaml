<UserControl x:Class="DrawingTree.Controls.AllPosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DrawingTree.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <Geometry x:Key="OpenInNewGeo">M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z</Geometry>
        <Geometry x:Key="CheckCircleGeo">M382-240 154-468l57-57 171 171 367-367 57 57-424 424Zm98 160q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</Geometry>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToGridLengthConverter x:Key="BoolToWidth"/>
        <local:OeColumnConfig x:Key="OeColCfg"/>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Read-only TextBox styled as plain text — for OE view row cells -->
        <Style x:Key="SelectableCell" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Read-only TextBox styled as plain text — for Simple View fields -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar: [Title | Search | Buttons] -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title + count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" Text="All Purchase Orders"
                               FontSize="13" FontWeight="SemiBold" Foreground="#555555"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PoCountLabel" Text=""
                               FontSize="12" Foreground="#888888"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: search bar (same style as SearchControl) -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="PoSearchBox"
                             Height="28" Padding="5,4" FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="PoSearchBox_TextChanged"/>
                    <TextBlock x:Name="PoPlaceholderText"
                               Text="Search PO / Job / Drawing"
                               IsHitTestVisible="False"
                               Foreground="#AAAAAA" FontSize="13"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Right: buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="NewJobButton" Content="New Job"
                            Style="{StaticResource ToolbarBtn}"
                            Click="NewJobButton_Click"/>
                    <Button x:Name="HistoryButton" Content="History Orders"
                            Style="{StaticResource ToolbarBtn}"
                            Click="HistoryButton_Click"/>

                    <!-- Filter (Customer / Contact / Due Date range) — OE view only -->
                    <Button x:Name="FilterButton" Content="Filter"
                            Style="{StaticResource ToolbarBtn}"
                            Visibility="Collapsed"
                            Click="FilterButton_Click"/>
                    <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom"
                           StaysOpen="True">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                                Padding="12,10" Width="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.18" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Customer" FontSize="11" Foreground="#555555" Margin="0,0,0,3"/>
                                <ComboBox x:Name="FilterCustomerBox" Height="28" FontSize="12"
                                          SelectionChanged="FilterCustomerBox_SelectionChanged"/>

                                <TextBlock Text="Contact" FontSize="11" Foreground="#555555" Margin="0,8,0,3"/>
                                <ComboBox x:Name="FilterContactBox" Height="28" FontSize="12" IsEnabled="False"/>

                                <TextBlock Text="Due Date" FontSize="11" Foreground="#555555" Margin="0,8,0,3"/>
                                <TextBlock Text="From" FontSize="11" Foreground="#888888" Margin="0,0,0,2"/>
                                <DatePicker x:Name="FilterDueFromPicker" Height="28"/>
                                <TextBlock Text="To" FontSize="11" Foreground="#888888" Margin="0,6,0,2"/>
                                <DatePicker x:Name="FilterDueToPicker" Height="28"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="Filter" Height="26" Padding="10,0" FontSize="12"
                                            Margin="0,0,6,0" Click="ApplyFilterButton_Click"/>
                                    <Button Content="Cancel" Height="26" Padding="10,0" FontSize="12"
                                            Click="CancelFilterButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Columns (OE view row column visibility) — OE view only -->
                    <Button x:Name="ColumnsButton" Content="Columns"
                            Style="{StaticResource ToolbarBtn}"
                            Visibility="Collapsed"
                            Click="ColumnsButton_Click"/>
                    <Popup x:Name="ColumnsPopup"
                           PlacementTarget="{Binding ElementName=ColumnsButton}"
                           Placement="Bottom"
                           StaysOpen="False">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.18" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="COLUMNS" FontSize="9" FontWeight="SemiBold" Foreground="#999999" Margin="0,0,0,6"/>
                                <CheckBox Content="O.E." FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowOe}"/>
                                <CheckBox Content="Line No" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowLine}"/>
                                <CheckBox Content="Customer" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowCustomer}"/>
                                <CheckBox Content="Contact" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowContact}"/>
                                <CheckBox Content="Qty" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowQty}"/>
                                <CheckBox Content="Rev." FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowRev}"/>
                                <CheckBox Content="Description" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowDescription}"/>
                                <CheckBox Content="Rls Date" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowRlsDate}"/>
                                <CheckBox Content="Due Date" FontSize="12" Margin="0,2"
                                          IsChecked="{Binding Source={StaticResource OeColCfg}, Path=ShowDueDate}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="ToggleViewButton" Content="OE View"
                            Style="{StaticResource ToolbarBtn}"
                            Click="ToggleViewButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1" x:Name="ContentGrid">

            <local:LoadingOverlayControl x:Name="LoadingOverlay"
                                         Visibility="Collapsed" Panel.ZIndex="10"/>

            <!-- ── OE View ─────────────────────────────────────────────────── -->
            <!-- Grouped by PO with virtualization only at the group (PO) level — mirrors Simple View's
                 mechanism below. DataGrid row-level virtualization/recycling was still laggy on scroll
                 even after removing RelativeSource bindings (see commit d1d7e62 / Issue #43), so OE View
                 gave up the DataGrid entirely in favor of this proven-smooth structure. A single global
                 sticky header (Row 0) replaces the old per-PO-group header; its horizontal scroll offset
                 is synced from the content ScrollViewer in code-behind (OeGroupsScroll_ScrollChanged),
                 since ScrollViewer has no native "frozen row that still tracks horizontal scroll". -->
            <Grid x:Name="OeViewRoot" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Global sticky column header -->
                <ScrollViewer Grid.Row="0" x:Name="OeHeaderScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <Border Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="0,6">
                        <Grid MinWidth="1600">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowOe, Converter={StaticResource BoolToWidth}, ConverterParameter=80}"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowLine, Converter={StaticResource BoolToWidth}, ConverterParameter=70}"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowCustomer, Converter={StaticResource BoolToWidth}, ConverterParameter=140}"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowContact, Converter={StaticResource BoolToWidth}, ConverterParameter=160}"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowQty, Converter={StaticResource BoolToWidth}, ConverterParameter=60}"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowRev, Converter={StaticResource BoolToWidth}, ConverterParameter=60}"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowDescription, Converter={StaticResource BoolToWidth}, ConverterParameter=*}"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowRlsDate, Converter={StaticResource BoolToWidth}, ConverterParameter=100}"/>
                                <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowDueDate, Converter={StaticResource BoolToWidth}, ConverterParameter=100}"/>
                                <ColumnDefinition Width="50"/>
                                <!-- Spacer matching the content ScrollViewer's vertical scrollbar width, so columns stay aligned at max horizontal scroll -->
                                <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"  Text="P.O."            FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2"  Text="O.E."             FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="3"  Text="Job No"           FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="4"  Text="Line No"          FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="5"  Text="Customer"         FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="6"  Text="Contact"          FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="7"  Text="Qty"              FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="8"  Text="Drawing Number"   FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="9"  Text="PDF"              FontSize="11" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Text="Rev."             FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="11" Text="Description"      FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="12" Text="Rls Date"         FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="13" Text="Due Date"         FontSize="11" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center" Margin="8,0"/>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" x:Name="OeGroupsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              ScrollChanged="OeGroupsScroll_ScrollChanged">
                <!-- VirtualizingStackPanel here does not actually virtualize (see the same note on
                     SimpleViewList above) — every PO group/row is realized up front. Loading
                     performance is handled by incremental mounting in AllPosControl.xaml.cs
                     (ApplySearchAsync/MountIncrementallyAsync) instead. -->
                <ItemsControl x:Name="OeGroupsList" Background="#F4F5F6"
                              AlternationCount="100000">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:OePoGroup}">
                            <!-- PO group card: half-row gap above (skipped for the first group via
                                 AlternationIndex, since it already sits right under the sticky header),
                                 light top border, white card background against the page's light gray,
                                 and a soft bottom shadow. The shadow is a plain gradient strip rather than
                                 a Border.Effect — an Effect forces the whole subtree (including all the row
                                 text) through a bitmap layer and visibly blurs it. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0,12,0,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                <Setter Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                                    <!-- Rows within this PO group — not virtualized, matching Simple View's Items level. -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:OeRowItem}">
                                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,3">
                                                    <Border.Style>
                                                        <!-- Child (expanded) rows: distinct background, and dim the columns duplicated
                                                             from the parent row (TextElement.Foreground inherits down to any cell that
                                                             doesn't set its own Foreground) so the child-specific Drawing/Rev/Description
                                                             cells stand out by contrast. -->
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChildRow}" Value="True">
                                                                    <Setter Property="Background" Value="#F1F3F7"/>
                                                                    <Setter Property="TextElement.Foreground" Value="#9E9E9E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid MinWidth="1600">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowOe, Converter={StaticResource BoolToWidth}, ConverterParameter=80}"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowLine, Converter={StaticResource BoolToWidth}, ConverterParameter=70}"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowCustomer, Converter={StaticResource BoolToWidth}, ConverterParameter=140}"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowContact, Converter={StaticResource BoolToWidth}, ConverterParameter=160}"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowQty, Converter={StaticResource BoolToWidth}, ConverterParameter=60}"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowRev, Converter={StaticResource BoolToWidth}, ConverterParameter=60}"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowDescription, Converter={StaticResource BoolToWidth}, ConverterParameter=*}"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowRlsDate, Converter={StaticResource BoolToWidth}, ConverterParameter=100}"/>
                                                            <ColumnDefinition Width="{Binding Source={StaticResource OeColCfg}, Path=ShowDueDate, Converter={StaticResource BoolToWidth}, ConverterParameter=100}"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Expand — reveal child drawings for assemblies -->
                                                        <Button Grid.Column="0" Width="18" Height="18"
                                                                Style="{StaticResource IconLinkBtn}"
                                                                Padding="0"
                                                                Visibility="{Binding ExpandButtonVisibility}"
                                                                Tag="{Binding}"
                                                                Click="OeExpandItem_Click">
                                                            <Path Stretch="Uniform" Fill="#555555" Width="12" Height="12"
                                                                  Data="{Binding ExpandIconGeometry}"/>
                                                        </Button>

                                                        <!-- P.O. — searchable; hyperlink to PO Detail on the first row of each PO group -->
                                                        <Grid Grid.Column="1">
                                                            <TextBox Text="{Binding PoNumberDisplay, Mode=OneWay}"
                                                                     Foreground="{Binding PoLinkForeground}"
                                                                     Cursor="{Binding PoLinkCursor}"
                                                                     Tag="{Binding}" PreviewMouseLeftButtonDown="OePoNumber_Click">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock local:HighlightBehavior.FullText="{Binding PoNumberDisplay}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                       Foreground="{Binding PoLinkForeground}"
                                                                       TextDecorations="{Binding PoLinkDecorations}"
                                                                       Cursor="{Binding PoLinkCursor}"
                                                                       Tag="{Binding}" MouseLeftButtonDown="OePoNumber_Click"
                                                                       VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- O.E. — searchable -->
                                                        <Grid Grid.Column="2">
                                                            <TextBox Text="{Binding OeNumber, Mode=OneWay}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock local:HighlightBehavior.FullText="{Binding OeNumber}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                       VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Job No — searchable -->
                                                        <Grid Grid.Column="3">
                                                            <TextBox Text="{Binding JobNumber, Mode=OneWay}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock local:HighlightBehavior.FullText="{Binding JobNumber}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                       VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Line No — not searchable, plain TextBox -->
                                                        <TextBox Grid.Column="4" Text="{Binding LineNumber, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>

                                                        <!-- Customer — searchable -->
                                                        <Grid Grid.Column="5">
                                                            <TextBox Text="{Binding CustomerName, Mode=OneWay}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock local:HighlightBehavior.FullText="{Binding CustomerName}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                       VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Contact — plain TextBox -->
                                                        <TextBox Grid.Column="6" Text="{Binding ContactName, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>

                                                        <!-- Qty — plain TextBox -->
                                                        <TextBox Grid.Column="7" Text="{Binding Quantity, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>

                                                        <!-- Drawing Number — hyperlink to Drawing/Part Detail, searchable via highlight -->
                                                        <TextBlock Grid.Column="8" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                                                   HorizontalAlignment="Left"
                                                                   Foreground="{Binding DrawingLinkForeground}"
                                                                   TextDecorations="{Binding DrawingLinkDecorations}"
                                                                   Cursor="{Binding DrawingLinkCursor}"
                                                                   Tag="{Binding}"
                                                                   MouseLeftButtonDown="OeDrawingNumber_Click"
                                                                   local:HighlightBehavior.FullText="{Binding DrawingNumber}"
                                                                   local:HighlightBehavior.SearchTerm="{Binding SearchTerm}">
                                                            <TextBlock.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                </ContextMenu>
                                                            </TextBlock.ContextMenu>
                                                        </TextBlock>

                                                        <!-- PDF — open the linked drawing file -->
                                                        <Button Grid.Column="9"
                                                                Visibility="{Binding PdfButtonVisibility}"
                                                                IsEnabled="{Binding HasPdf}"
                                                                Tag="{Binding}" Click="OpenOePdfButton_Click"
                                                                Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                ToolTip="Open PDF">
                                                            <Viewbox Width="13" Height="13">
                                                                <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="{Binding PdfIconFill}"/>
                                                            </Viewbox>
                                                        </Button>

                                                        <!-- Rev. — plain TextBox. Explicit Foreground so it stays full-contrast on child
                                                             rows, overriding the dimmed color inherited from the row Border (this is the
                                                             child's own data, not duplicated from the parent). -->
                                                        <TextBox Grid.Column="10" Text="{Binding Revision, Mode=OneWay}" Style="{StaticResource SelectableCell}" Foreground="#212121"/>

                                                        <!-- Description — searchable, with trimming/tooltip. Explicit Foreground for the
                                                             same reason as Rev. above — this is child-specific data. -->
                                                        <Grid Grid.Column="11">
                                                            <TextBox Text="{Binding DescriptionDisplay, Mode=OneWay}"
                                                                     ToolTip="{Binding DescriptionDisplay}"
                                                                     Foreground="#212121">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableCell}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock local:HighlightBehavior.FullText="{Binding DescriptionDisplay}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding DescriptionDisplay}"
                                                                       Foreground="#212121"
                                                                       VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Rls Date — plain TextBox -->
                                                        <TextBox Grid.Column="12" Text="{Binding ReleaseDate, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>

                                                        <!-- Due Date — plain TextBox -->
                                                        <TextBox Grid.Column="13" Text="{Binding DueDate, Mode=OneWay}" Style="{StaticResource SelectableCell}"/>

                                                        <!-- Row menu -->
                                                        <Button Grid.Column="14" Content="⋮" FontSize="14" Style="{StaticResource IconLinkBtn}"
                                                                Tag="{Binding}" Click="OeRowMenu_Click">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Edit Item" Click="EditItem_ContextMenu_Click"/>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Border Height="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#22000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Simple View ────────────────────────────────────────────── -->
            <ScrollViewer x:Name="SimpleViewScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="True"
                          Visibility="Collapsed">
                <!-- VirtualizingStackPanel here does not actually virtualize: this ScrollViewer wraps
                     the ItemsControl from the outside instead of living inside its control template
                     (as ListBox's does), so the panel never gets a real IScrollInfo viewport and every
                     group/row is realized up front. Kept only because VirtualizingStackPanel avoids the
                     layout overhead of a plain StackPanel; loading performance is instead handled by
                     incremental mounting in AllPosControl.xaml.cs (ApplySearchAsync/MountIncrementallyAsync). -->
                <ItemsControl x:Name="SimpleViewList" Background="White">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PoSimpleGroup}">
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,8,0,0">

                                <!-- PO header row -->
                                <StackPanel>
                                    <Border Background="#F0F4F8" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Margin="0,0,16,0" FontSize="12" FontWeight="SemiBold" Foreground="#1A237E">
                                                    <Run Text="PO: "/><Run Text="{Binding PoNumberDisplay, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555">
                                                    <Run Text="OE: "/><Run Text="{Binding OeNumber}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555">
                                                    <Run Text="Customer: "/><Run Text="{Binding CustomerName}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="#555">
                                                    <Run Text="Contact: "/><Run Text="{Binding ContactName}"/>
                                                </TextBlock>
                                            </WrapPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tree" Height="24" FontSize="11"
                                                        Margin="0,0,4,0" Padding="8,0"
                                                        Tag="{Binding}" Click="SimplePoTreeButton_Click"/>
                                                <Button Content="Package Tracker" Height="24" FontSize="11"
                                                        Margin="0,0,4,0" Padding="8,0"
                                                        Tag="{Binding PoId}" Click="SimplePoDetailButton_Click"/>
                                                <Button Content="⋮" FontSize="14" Style="{StaticResource IconLinkBtn}"
                                                        Tag="{Binding}" Click="PoHeaderMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Mark As Shipped" Tag="{Binding PoId}"
                                                                      Click="MarkAsShipped_Click"/>
                                                            <MenuItem Header="Input Data" Tag="{Binding PoNumber}"
                                                                      Click="InputData_Click"/>
                                                            <MenuItem Header="Edit Parts"
                                                                      Click="EditParts_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Column header row -->
                                    <Border Background="#E8EAF0" Padding="0,3">
                                        <Grid MinWidth="940">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Job"            FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="Ln"             FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="3" Text="Qty"            FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="4" Text="Drawing Number" FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="5" Text="Description"    FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="6" Text="PDF"            FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="7" Text="MP"             FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="8" Text="DIR"            FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="9" Text="Rls Date"       FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="10" Text="Due Date"      FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Order item rows -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ExpandableOrderItem}">
                                                <StackPanel>
                                                    <!-- Main row -->
                                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"
                                                            Padding="0,3">
                                                        <Grid MinWidth="940">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Expand icon -->
                                                            <Button Grid.Column="0"
                                                                    Width="18" Height="18"
                                                                    Style="{StaticResource IconLinkBtn}"
                                                                    Padding="0"
                                                                    Visibility="{Binding ExpandButtonVisibility}"
                                                                    Tag="{Binding}"
                                                                    Click="ExpandItem_Click">
                                                                <Path Stretch="Uniform" Fill="#555555" Width="12" Height="12"
                                                                      Data="{Binding ExpandIconGeometry}"/>
                                                            </Button>
                                                            <!-- Job number — selectable -->
                                                            <TextBox Grid.Column="1" Text="{Binding Row.JobNumber, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Line number — selectable -->
                                                            <TextBox Grid.Column="2" Text="{Binding Row.LineNumber, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Qty — selectable -->
                                                            <TextBox Grid.Column="3" Text="{Binding Row.Quantity, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Drawing Number — link TextBlock with HorizontalAlignment=Left to fix click area -->
                                                            <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                                                       HorizontalAlignment="Left"
                                                                       Foreground="{Binding DrawingLinkForeground}"
                                                                       TextDecorations="{Binding DrawingLinkDecorations}"
                                                                       Cursor="{Binding DrawingLinkCursor}"
                                                                       Tag="{Binding}"
                                                                       MouseLeftButtonDown="DrawingNumberMain_Click"
                                                                       local:HighlightBehavior.FullText="{Binding Row.DrawingNumber}"
                                                                       local:HighlightBehavior.SearchTerm="{Binding SearchTerm}">
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>
                                                            <!-- Description — toggle TextBox/TextBlock for selection + highlight -->
                                                            <Grid Grid.Column="5">
                                                                <TextBox Text="{Binding Row.DescriptionDisplay, Mode=OneWay}"
                                                                         ToolTip="{Binding Row.DescriptionDisplay}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock local:HighlightBehavior.FullText="{Binding Row.DescriptionDisplay}"
                                                                           local:HighlightBehavior.SearchTerm="{Binding SearchTerm}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Row.DescriptionDisplay}"
                                                                           VerticalAlignment="Center" Margin="4,0" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <TextBlock.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                        </ContextMenu>
                                                                    </TextBlock.ContextMenu>
                                                                </TextBlock>
                                                            </Grid>
                                                            <!-- PDF button -->
                                                            <Button Grid.Column="6"
                                                                    Visibility="{Binding PartButtonVisibility}"
                                                                    IsEnabled="{Binding HasPdf}"
                                                                    Tag="{Binding}" Click="OpenPartButton_Click"
                                                                    Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    ToolTip="Open PDF">
                                                                <Viewbox Width="13" Height="13">
                                                                    <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="{Binding PdfIconFill}"/>
                                                                </Viewbox>
                                                            </Button>
                                                            <!-- MP icon -->
                                                            <Viewbox Grid.Column="7" Width="14" Height="14"
                                                                     Visibility="{Binding MpIconVisibility}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                            </Viewbox>
                                                            <!-- DIR icon -->
                                                            <Viewbox Grid.Column="8" Width="14" Height="14"
                                                                     Visibility="{Binding DirIconVisibility}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                            </Viewbox>
                                                            <!-- Rls Date — selectable -->
                                                            <TextBox Grid.Column="9" Text="{Binding Row.ReleaseDate, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Due Date — selectable -->
                                                            <TextBox Grid.Column="10" Text="{Binding Row.DueDate, Mode=OneWay}"
                                                                     Style="{StaticResource SelectableText}"/>
                                                            <!-- Row menu -->
                                                            <Button Grid.Column="11" Content="⋮" FontSize="14"
                                                                    Style="{StaticResource IconLinkBtn}"
                                                                    Tag="{Binding}" Click="ItemRowMenu_Click">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Edit Item"
                                                                                  Click="EditItem_ContextMenu_Click"/>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Child rows (shown when expanded) -->
                                                    <ItemsControl ItemsSource="{Binding Children}"
                                                                  Visibility="{Binding ChildrenVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:ChildDrawingItem}">
                                                                <Border Background="#FAFAFA"
                                                                        BorderBrush="#EEEEEE"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,3">
                                                                    <Grid MinWidth="940">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="24"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="200"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Drawing Number — link TextBlock with HorizontalAlignment=Left -->
                                                                        <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                                                                   HorizontalAlignment="Left"
                                                                                   Foreground="{Binding DrawingLinkForeground}"
                                                                                   TextDecorations="{Binding DrawingLinkDecorations}"
                                                                                   Cursor="{Binding DrawingLinkCursor}"
                                                                                   Tag="{Binding}"
                                                                                   MouseLeftButtonDown="DrawingNumberChild_Click"
                                                                                   local:HighlightBehavior.FullText="{Binding DrawingNumber}"
                                                                                   local:HighlightBehavior.SearchTerm="{Binding SearchTerm}">
                                                                            <TextBlock.ContextMenu>
                                                                                <ContextMenu>
                                                                                    <MenuItem Header="Copy" Click="CopyText_Click"/>
                                                                                </ContextMenu>
                                                                            </TextBlock.ContextMenu>
                                                                        </TextBlock>
                                                                        <!-- Description — selectable TextBox -->
                                                                        <TextBox Grid.Column="5" Text="{Binding Description, Mode=OneWay}"
                                                                                 Style="{StaticResource SelectableText}"/>
                                                                        <!-- PDF button -->
                                                                        <Button Grid.Column="6"
                                                                                Visibility="{Binding PdfButtonVisibility}"
                                                                                IsEnabled="{Binding HasPdf}"
                                                                                Tag="{Binding}" Click="OpenChildPdfButton_Click"
                                                                                Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                ToolTip="Open PDF">
                                                                            <Viewbox Width="13" Height="13">
                                                                                <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="{Binding PdfIconFill}"/>
                                                                            </Viewbox>
                                                                        </Button>
                                                                        <!-- MP icon -->
                                                                        <Viewbox Grid.Column="7" Width="14" Height="14"
                                                                                 Visibility="{Binding MpIconVisibility}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                                        </Viewbox>
                                                                        <!-- DIR icon -->
                                                                        <Viewbox Grid.Column="8" Width="14" Height="14"
                                                                                 Visibility="{Binding DirIconVisibility}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                                        </Viewbox>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
