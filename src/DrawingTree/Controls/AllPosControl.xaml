<UserControl x:Class="DrawingTree.Controls.AllPosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DrawingTree.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <Geometry x:Key="OpenInNewGeo">M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z</Geometry>
        <Geometry x:Key="CheckCircleGeo">M382-240 154-468l57-57 171 171 367-367 57 57-424 424Zm98 160q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</Geometry>
        <Style x:Key="HeaderCell" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="BodyCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}"/>
                    <Setter Property="Foreground" Value="{x:Static SystemColors.HighlightTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" Text="All Purchase Orders"
                               FontSize="13" FontWeight="SemiBold" Foreground="#555555"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PoCountLabel" Text=""
                               FontSize="12" Foreground="#888888"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewJobButton" Content="New Job"
                            Style="{StaticResource ToolbarBtn}"
                            Click="NewJobButton_Click"/>
                    <Button x:Name="HistoryButton" Content="History Orders"
                            Style="{StaticResource ToolbarBtn}"
                            Click="HistoryButton_Click"/>
                    <Button x:Name="ToggleViewButton" Content="OE View"
                            Style="{StaticResource ToolbarBtn}"
                            Click="ToggleViewButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area: OE View (DataGrid) and Simple View toggle -->
        <Grid Grid.Row="1" x:Name="ContentGrid">

            <local:LoadingOverlayControl x:Name="LoadingOverlay"
                                         Visibility="Collapsed" Panel.ZIndex="10"/>

            <!-- ── OE View ─────────────────────────────────────────────────── -->
            <DataGrid x:Name="ResultsGrid"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      ColumnHeaderStyle="{StaticResource HeaderCell}"
                      CellStyle="{StaticResource BodyCell}"
                      PreviewMouseRightButtonUp="ResultsGrid_MouseRightButtonUp">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <StackPanel>
                                                <Border Height="12" Background="Transparent"/>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="P.O."          Binding="{Binding PoNumber}"      Width="200"/>
                    <DataGridTextColumn Header="O.E."          Binding="{Binding OeNumber}"      Width="80"/>
                    <DataGridTextColumn Header="Job No"        Binding="{Binding JobNumber}"     Width="80"/>
                    <DataGridTextColumn Header="Line No"       Binding="{Binding LineNumber}"    Width="70"/>
                    <DataGridTextColumn Header="Customer"      Binding="{Binding CustomerName}"  Width="140"/>
                    <DataGridTextColumn Header="Contact"       Binding="{Binding ContactName}"   Width="160"/>
                    <DataGridTextColumn Header="Qty"           Binding="{Binding Quantity}"      Width="60"/>
                    <DataGridTextColumn Header="Drawing Number" Binding="{Binding DrawingNumber}" Width="220"/>
                    <DataGridTextColumn Header="Rev."          Binding="{Binding Revision}"      Width="60"/>
                    <DataGridTextColumn Header="Description"   Binding="{Binding Description}"  Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Rls Date"      Binding="{Binding ReleaseDate}"   Width="100"/>
                    <DataGridTextColumn Header="Due Date"      Binding="{Binding DueDate}"       Width="100"/>
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⋮" FontSize="14" Style="{StaticResource IconLinkBtn}"
                                        Tag="{Binding}" Click="OeRowMenu_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit Item" Click="EditItem_ContextMenu_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Simple View ────────────────────────────────────────────── -->
            <ScrollViewer x:Name="SimpleViewScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ItemsControl x:Name="SimpleViewList" Background="White">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PoSimpleGroup}">
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,8,0,0">

                                <!-- PO header row -->
                                <StackPanel>
                                    <Border Background="#F0F4F8" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Margin="0,0,16,0" FontSize="12" FontWeight="SemiBold" Foreground="#1A237E">
                                                    <Run Text="PO: "/><Run Text="{Binding PoNumber}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555">
                                                    <Run Text="OE: "/><Run Text="{Binding OeNumber}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,16,0" FontSize="12" Foreground="#555">
                                                    <Run Text="Customer: "/><Run Text="{Binding CustomerName}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="#555">
                                                    <Run Text="Contact: "/><Run Text="{Binding ContactName}"/>
                                                </TextBlock>
                                            </WrapPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Tree" Height="24" FontSize="11"
                                                        Margin="0,0,4,0" Padding="8,0"
                                                        Tag="{Binding}" Click="SimplePoTreeButton_Click"/>
                                                <Button Content="Package Tracker" Height="24" FontSize="11"
                                                        Margin="0,0,4,0" Padding="8,0"
                                                        Tag="{Binding PoId}" Click="SimplePoDetailButton_Click"/>
                                                <Button Content="⋮" FontSize="14" Style="{StaticResource IconLinkBtn}"
                                                        Tag="{Binding}" Click="PoHeaderMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Mark As Shipped" Tag="{Binding PoId}"
                                                                      Click="MarkAsShipped_Click"/>
                                                            <MenuItem Header="Input Data" Tag="{Binding PoNumber}"
                                                                      Click="InputData_Click"/>
                                                            <MenuItem Header="Edit Parts"
                                                                      Click="EditParts_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Column header row -->
                                    <Border Background="#E8EAF0" Padding="0,3">
                                        <Grid MinWidth="900">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Job"            FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="Ln"             FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="3" Text="Qty"            FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="4" Text="Drawing Number" FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="5" Text="Description"    FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="6" Text="PDF"            FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="7" Text="MP"             FontSize="11" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="8" Text="Rls Date"       FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Grid.Column="9" Text="Due Date"       FontSize="11" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Order item rows -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ExpandableOrderItem}">
                                                <StackPanel>
                                                    <!-- Main row -->
                                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"
                                                            Padding="0,3">
                                                        <Grid MinWidth="900">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Expand icon -->
                                                            <Button Grid.Column="0"
                                                                    Width="18" Height="18"
                                                                    Style="{StaticResource IconLinkBtn}"
                                                                    Padding="0"
                                                                    Visibility="{Binding ExpandButtonVisibility}"
                                                                    Tag="{Binding}"
                                                                    Click="ExpandItem_Click">
                                                                <Path Stretch="Uniform" Fill="#555555" Width="12" Height="12"
                                                                      Data="{Binding ExpandIconGeometry}"/>
                                                            </Button>
                                                            <TextBlock Grid.Column="1" Text="{Binding Row.JobNumber}"     FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Row.LineNumber}"    FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Row.Quantity}"      FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                                            <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                                                       Text="{Binding Row.DrawingNumber}"
                                                                       Foreground="{Binding DrawingLinkForeground}"
                                                                       TextDecorations="{Binding DrawingLinkDecorations}"
                                                                       Cursor="{Binding DrawingLinkCursor}"
                                                                       Tag="{Binding}"
                                                                       MouseLeftButtonDown="DrawingNumberMain_Click"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Row.Description}" FontSize="12"
                                                                       VerticalAlignment="Center" Margin="4,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Row.Description}"/>
                                                            <Button Grid.Column="6"
                                                                    Visibility="{Binding PartButtonVisibility}"
                                                                    Tag="{Binding}" Click="OpenPartButton_Click"
                                                                    Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    ToolTip="Open PDF">
                                                                <Viewbox Width="13" Height="13">
                                                                    <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="DodgerBlue"/>
                                                                </Viewbox>
                                                            </Button>
                                                            <Viewbox Grid.Column="7" Width="14" Height="14"
                                                                     Visibility="{Binding MpIconVisibility}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                            </Viewbox>
                                                            <TextBlock Grid.Column="8" Text="{Binding Row.ReleaseDate}"   FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                                            <TextBlock Grid.Column="9" Text="{Binding Row.DueDate}"       FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                                            <Button Grid.Column="10" Content="⋮" FontSize="14"
                                                                    Style="{StaticResource IconLinkBtn}"
                                                                    Tag="{Binding}" Click="ItemRowMenu_Click">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Edit Item"
                                                                                  Click="EditItem_ContextMenu_Click"/>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Child rows (shown when expanded) -->
                                                    <ItemsControl ItemsSource="{Binding Children}"
                                                                  Visibility="{Binding ChildrenVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:ChildDrawingItem}">
                                                                <Border Background="#FAFAFA"
                                                                        BorderBrush="#EEEEEE"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,3">
                                                                    <Grid MinWidth="900">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="24"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="200"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                                                                   Text="{Binding DrawingNumber}"
                                                                                   Foreground="{Binding DrawingLinkForeground}"
                                                                                   TextDecorations="{Binding DrawingLinkDecorations}"
                                                                                   Cursor="{Binding DrawingLinkCursor}"
                                                                                   Tag="{Binding}"
                                                                                   MouseLeftButtonDown="DrawingNumberChild_Click"/>
                                                                        <TextBlock Grid.Column="5" Text="{Binding Description}" FontSize="12"
                                                                                   VerticalAlignment="Center" Margin="4,0"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <Button Grid.Column="6"
                                                                                Visibility="{Binding PdfButtonVisibility}"
                                                                                Tag="{Binding}" Click="OpenChildPdfButton_Click"
                                                                                Style="{StaticResource IconLinkBtn}" Padding="2,0"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                ToolTip="Open PDF">
                                                                            <Viewbox Width="13" Height="13">
                                                                                <Path Data="{StaticResource OpenInNewGeo}" Stretch="Uniform" Fill="DodgerBlue"/>
                                                                            </Viewbox>
                                                                        </Button>
                                                                        <Viewbox Grid.Column="7" Width="14" Height="14"
                                                                                 Visibility="{Binding MpIconVisibility}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource CheckCircleGeo}" Stretch="Uniform" Fill="#2E7D32"/>
                                                                        </Viewbox>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
