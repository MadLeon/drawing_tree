<UserControl x:Class="DrawingTree.Controls.PartDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <Geometry x:Key="OpenInNewGeo">M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z</Geometry>
        <Geometry x:Key="ContentCopyGeo">M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z</Geometry>

    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Style="{StaticResource IconBtn}"
                        Width="28" Height="28" Margin="0,0,8,0"
                        ToolTip="Back to PO detail"
                        Click="BackButton_Click">
                    <Path Data="{StaticResource ChevronLeftGeo}"
                          Stretch="Uniform" Fill="#333333" Width="14" Height="14"/>
                </Button>
                <TextBox x:Name="TitleLabel" Style="{StaticResource SelectableTitleText}"
                         FontWeight="Bold" FontSize="14"
                         VerticalAlignment="Center" Foreground="#333"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <!-- Notes -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="#FAFAFA">
                    <StackPanel>
                        <TextBox Text="Notes" Style="{StaticResource SelectableTitleText}"
                                 FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <StackPanel x:Name="NotesListPanel" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NewNoteTextBox" Width="400" Height="28"
                                     VerticalContentAlignment="Center" Padding="4,0"/>
                            <Button Content="Add" Width="60" Height="28" Margin="8,0,0,0"
                                    Click="AddNoteButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Basic info -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="White">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="Basic Info" Style="{StaticResource SelectableTitleText}"
                                     FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="Tree View" Height="24" FontSize="11" Padding="8,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="TreeViewButton_Click"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left: part info -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" Grid.Column="0" Text="Revision" Style="{StaticResource SelectableText}" FontSize="12" Foreground="Gray"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RevisionText" Style="{StaticResource SelectableText}" FontSize="12"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="Description" Style="{StaticResource SelectableText}" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionText" Style="{StaticResource SelectableText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="2" Grid.Column="0" Text="Is Assembly" Style="{StaticResource SelectableText}" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="IsAssemblyText" Style="{StaticResource SelectableText}" FontSize="12" Margin="0,4,0,0"/>
                            </Grid>
                            <!-- Right: PO / Job / Line (only when context is available) -->
                            <StackPanel Grid.Column="1" x:Name="PoInfoPanel" Visibility="Collapsed" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0" Text="PO Number" Style="{StaticResource SelectableText}" FontSize="12" Foreground="Gray"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="PoNumberText" Style="{StaticResource SelectableText}" FontSize="12"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="Job Number" Style="{StaticResource SelectableText}" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="JobNumberText" Style="{StaticResource SelectableText}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="0" Text="Line" Style="{StaticResource SelectableText}" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="LineText" Style="{StaticResource SelectableText}" FontSize="12" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Drawing PDF -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="White">
                    <StackPanel>
                        <TextBox Text="Drawing PDF" Style="{StaticResource SelectableTitleText}"
                                 FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <StackPanel x:Name="PdfListPanel"/>
                    </StackPanel>
                </Border>

                <!-- Manufacturing Process -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="White">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="Manufacturing Process" Style="{StaticResource SelectableTitleText}"
                                     FontWeight="Bold" FontSize="13"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="OpenMpFolderButton" Content="Open Folder"
                                    Height="24" FontSize="11" Padding="8,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="OpenMpFolderButton_Click"/>
                            <Button x:Name="NewMpButton" Content="New MP"
                                    Height="24" FontSize="11" Padding="8,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="NewMpButton_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="MpFilesPanel"/>
                    </StackPanel>
                </Border>

                <!-- DIR -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="White">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="DIR" Style="{StaticResource SelectableTitleText}"
                                     FontWeight="Bold" FontSize="13"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="OpenDirFolderButton" Content="Open Folder"
                                    Height="24" FontSize="11" Padding="8,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="OpenDirFolderButton_Click"/>
                            <Button x:Name="NewDirButton" Content="New DIR"
                                    Height="24" FontSize="11" Padding="8,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="NewDirButton_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="DirFilesPanel"/>
                    </StackPanel>
                </Border>

                <!-- Bubble Drawing -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="White">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="Bubble Drawing" Style="{StaticResource SelectableTitleText}"
                                     FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Button x:Name="CopyBubbleNameButton" Style="{StaticResource IconLinkBtn}"
                                    Margin="6,0,0,0" Padding="2" VerticalAlignment="Center"
                                    ToolTip="Copy DISCUS file name"
                                    Click="CopyBubbleNameButton_Click">
                                <Path Data="{StaticResource ContentCopyGeo}" Stretch="Uniform" Fill="#555555" Width="14" Height="14"/>
                            </Button>
                            <Button x:Name="AssociateBubbleButton" Content="Associate"
                                    Height="24" FontSize="11" Padding="8,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="AssociateBubbleButton_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="BubbleFilesPanel"/>
                    </StackPanel>
                </Border>

                <!-- Process Template -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,12" Padding="10" Background="White">
                    <StackPanel>
                        <TextBox Text="Process Template" Style="{StaticResource SelectableTitleText}"
                                 FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ProcessStepsPanel"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
