<UserControl x:Class="DrawingTree.Controls.PartEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DrawingTree.Models"
             xmlns:local="clr-namespace:DrawingTree.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- Material Icons path geometries -->
        <Geometry x:Key="OpenInNewGeo">M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z</Geometry>
        <Geometry x:Key="CheckCircleGeo">M382-240 154-468l57-57 171 171 367-367 57 57-424 424Zm98 160q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</Geometry>
        <Geometry x:Key="CancelGeo">M336-280 480-424l144 144 56-56-144-144 144-144-56-56-144 144-144-144-56 56 144 144-144 144 56 56ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</Geometry>

        <!-- Transparent icon button with subtle hover -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd" Background="Transparent" CornerRadius="2" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#15000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Background="#F0F0F0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PoLabel" Grid.Column="0"
                           FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save All" Width="80" Height="32"
                            Margin="0,0,10,0" Click="SaveAllButton_Click"/>
                    <Button Content="Return" Width="80" Height="32"
                            Click="ReturnButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content area ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column header row -->
            <Border Grid.Row="0" Background="#F5F5F5"
                    BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                    Padding="4,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"  Text="Drawing Number"  FontWeight="SemiBold" FontSize="11" Foreground="#555" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2"  Text="Revision"        FontWeight="SemiBold" FontSize="11" Foreground="#555" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="3"  Text="Description"     FontWeight="SemiBold" FontSize="11" Foreground="#555" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="4"  Text="Qty in Assembly" FontWeight="SemiBold" FontSize="11" Foreground="#555" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="5"  Text="Is Assembly"     FontWeight="SemiBold" FontSize="11" Foreground="#555" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="6"  Text="File Path"       FontWeight="SemiBold" FontSize="11" Foreground="#555" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- Scrollable part rows -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PartList" Background="White">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PartEditorRow}">
                            <Border x:Name="RowBorder"
                                    Background="White"
                                    BorderBrush="#EEEEEE"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,2">
                                <Grid MinWidth="1300">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="440"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: Index -->
                                    <TextBlock Grid.Column="0" Text="{Binding Index}"
                                               FontSize="12" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="#888"/>

                                    <!-- Col 1: Drawing Number (editable; LostFocus syncs JSON) -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding DrawingNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Height="26" Padding="4,3" FontSize="12" Margin="2,1"
                                             LostFocus="DrawingNumber_LostFocus"/>

                                    <!-- Col 2: Revision -->
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}"
                                             Height="26" Padding="4,3" FontSize="12" Margin="2,1"/>

                                    <!-- Col 3: Description -->
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Height="26" Padding="4,3" FontSize="12" Margin="2,1"/>

                                    <!-- Col 4: Qty in Assembly -->
                                    <TextBox Grid.Column="4"
                                             Text="{Binding QuantityInAssembly, UpdateSourceTrigger=PropertyChanged}"
                                             Height="26" Padding="4,3" FontSize="12" Margin="2,1"/>

                                    <!-- Col 5: Is Assembly -->
                                    <CheckBox Grid.Column="5"
                                              IsChecked="{Binding IsAssembly}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Col 6: File Path -->
                                    <TextBox Grid.Column="6"
                                             Text="{Binding PdfPath, UpdateSourceTrigger=PropertyChanged}"
                                             Height="26" Padding="4,3" FontSize="11" Margin="2,1"
                                             ToolTip="{Binding PdfPath}"/>

                                    <!-- Col 7: Browse -->
                                    <Button Grid.Column="7" Content="Browse"
                                            Height="26" FontSize="11" Margin="2,1"
                                            Click="RowBrowseButton_Click"/>

                                    <!-- Col 8: Open PDF -->
                                    <Button Grid.Column="8" Style="{StaticResource IconBtn}"
                                            Width="28" Height="26" ToolTip="Open PDF"
                                            Click="RowOpenPdfButton_Click">
                                        <Path Data="{StaticResource OpenInNewGeo}"
                                              Stretch="Uniform" Fill="#1976D2"
                                              Width="14" Height="14"/>
                                    </Button>

                                    <!-- Col 9: Save -->
                                    <Button Grid.Column="9" Content="Save"
                                            Height="26" FontSize="11" Margin="2,1"
                                            Click="RowSaveButton_Click"/>

                                    <!-- Col 10: Status icon -->
                                    <Grid Grid.Column="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="CheckCirclePath"
                                              Data="{StaticResource CheckCircleGeo}"
                                              Stretch="Uniform"
                                              Fill="#43A047" Width="18" Height="18"
                                              Visibility="Collapsed"/>
                                        <Path x:Name="CancelPath"
                                              Data="{StaticResource CancelGeo}"
                                              Stretch="Uniform"
                                              Fill="#E53935" Width="18" Height="18"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter TargetName="CheckCirclePath" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="CancelPath" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Snackbar notification overlay -->
        <local:SnackbarControl x:Name="Snackbar"
                               Grid.Row="0" Grid.RowSpan="2"
                               Panel.ZIndex="20"/>
    </Grid>
</UserControl>
