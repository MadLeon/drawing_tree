<UserControl x:Class="DrawingTree.Controls.SnackbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border x:Name="SnackbarBorder"
            Background="#323232"
            CornerRadius="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            Padding="16,10"
            MinWidth="200"
            MaxWidth="500"
            Opacity="0">
        <TextBlock x:Name="MessageText"
                   Foreground="White"
                   FontSize="13"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
    </Border>
</UserControl>
