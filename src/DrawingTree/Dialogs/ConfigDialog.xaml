<Window x:Class="DrawingTree.Dialogs.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Config" Width="900" Height="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav -->
        <ListBox x:Name="NavList" Grid.Column="0" Background="#F0F0F0" BorderThickness="0,0,1,0" BorderBrush="#DDD"
                  ItemContainerStyle="{StaticResource NavItem}"
                  SelectionChanged="NavList_SelectionChanged">
            <ListBoxItem Content="Customer"/>
            <ListBoxItem Content="Contact"/>
            <ListBoxItem Content="Order Entry Log"/>
        </ListBox>

        <!-- Right content -->
        <Grid Grid.Column="1" Margin="20">

            <!-- Customer panel -->
            <Grid x:Name="CustomerPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="Customers" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="New Customer" Width="110" Height="28" HorizontalAlignment="Right"
                            Click="NewCustomerButton_Click"/>
                </DockPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CustomerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Name}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Remove" Width="70" Height="26"
                                                Tag="{Binding}" Click="RemoveCustomer_Click"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Drawing Folder:" Style="{StaticResource CardLabel}" Margin="0,8,8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DrawingFolder}" Style="{StaticResource CardValue}" Margin="0,8,0,0"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Width="70" Height="26" Margin="8,8,0,0"
                                                Tag="{Binding}" Click="BrowseCustomerDrawingFolder_Click"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="MP Folder:" Style="{StaticResource CardLabel}" Margin="0,4,8,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MpFolder}" Style="{StaticResource CardValue}" Margin="0,4,0,0"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="Browse" Width="70" Height="26" Margin="8,4,0,0"
                                                Tag="{Binding}" Click="BrowseCustomerMpFolder_Click"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bubble Dwg Folder:" Style="{StaticResource CardLabel}" Margin="0,4,8,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BubbleFolder}" Style="{StaticResource CardValue}" Margin="0,4,0,0"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="Browse" Width="70" Height="26" Margin="8,4,0,0"
                                                Tag="{Binding}" Click="BrowseCustomerBubbleFolder_Click"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="DIR Folder:" Style="{StaticResource CardLabel}" Margin="0,4,8,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DirFolder}" Style="{StaticResource CardValue}" Margin="0,4,0,0"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="Browse" Width="70" Height="26" Margin="8,4,0,0"
                                                Tag="{Binding}" Click="BrowseCustomerDirFolder_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Contact panel -->
            <Grid x:Name="ContactPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Contacts" FontSize="16" FontWeight="SemiBold"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ContactCustomerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="13"
                                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <Button Content="New Contact" Width="100" Height="26" HorizontalAlignment="Right"
                                                    Tag="{Binding}" Click="NewContactButton_Click"/>
                                        </DockPanel>

                                        <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Contacts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CardValue}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Email}" Style="{StaticResource CardValue}"/>
                                                        <Button Grid.Column="2" Content="Edit" Width="60" Height="24" Margin="0,0,4,0"
                                                                Tag="{Binding}" Click="EditContact_Click"/>
                                                        <Button Grid.Column="3" Content="Remove" Width="70" Height="24"
                                                                Tag="{Binding}" Click="RemoveContact_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Order Entry Log (OE) panel -->
            <Grid x:Name="OePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Order Entry Log" FontSize="16" FontWeight="SemiBold"/>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="OE Starting Page" FontSize="13" Margin="0,0,0,8"/>
                    <RadioButton x:Name="OeViewRadio" GroupName="LandingPage" Content="OE View" Margin="0,0,0,8"
                                 Checked="LandingPageRadio_Checked"/>
                    <RadioButton x:Name="SimpleViewRadio" GroupName="LandingPage" Content="Simple View"
                                 Checked="LandingPageRadio_Checked"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
