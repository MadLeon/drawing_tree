<Window x:Class="DrawingTree.Dialogs.ConfirmOverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Overwrite"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="The following fields differ from the database. Overwrite?"
                   FontSize="13"/>

        <!-- Column headers -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Field"
                       FontWeight="SemiBold" FontSize="12" Foreground="#555"/>
            <TextBlock Grid.Column="1" Text="Current"
                       FontWeight="SemiBold" FontSize="12" Foreground="#1976D2" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="2" Text="Database"
                       FontWeight="SemiBold" FontSize="12" Foreground="#E53935" Margin="8,0,0,0"/>
        </Grid>

        <Rectangle Grid.Row="3" Height="1" Fill="#E0E0E0"/>

        <!-- Diff rows -->
        <ItemsControl Grid.Row="4" x:Name="DiffList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Field}"
                                   FontSize="12" Foreground="#444" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Current}"
                                   FontSize="12" Foreground="#1976D2"
                                   Margin="8,0,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Database}"
                                   FontSize="12" Foreground="#E53935"
                                   Margin="8,0,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OverwriteButton" Content="Overwrite" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="OverwriteButton_Click"/>
            <Button Content="Cancel" Width="80" Height="28"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
