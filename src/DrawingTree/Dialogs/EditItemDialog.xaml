<Window x:Class="DrawingTree.Dialogs.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Item" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="IsEditable" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="TitleBlock" Text="Edit Item"
                   FontSize="15" FontWeight="SemiBold" Foreground="#333"/>

        <!-- Form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Customer -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer:" Style="{StaticResource Label}"/>
            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CustomerBox" Style="{StaticResource Combo}"
                       SelectionChanged="CustomerBox_SelectionChanged"/>

            <!-- Contact -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact:" Style="{StaticResource Label}"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="ContactBox" Style="{StaticResource Combo}"/>

            <!-- Drawing Number -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Drawing Number:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DrawingBox" Style="{StaticResource Field}"/>

            <!-- Rev -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rev:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="RevBox" Style="{StaticResource Field}"/>

            <!-- Description -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="DescBox" Style="{StaticResource Field}"/>

            <!-- Qty -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Qty:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="QtyBox" Style="{StaticResource Field}"/>

            <!-- Ln -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Ln:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="LnBox" Style="{StaticResource Field}"/>

            <!-- Del. Req'd -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Del. Req'd:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="DelBox" Style="{StaticResource Field}"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="Save" Width="80" Height="30" IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
