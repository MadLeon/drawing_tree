<Window x:Class="DrawingTree.Dialogs.OeAnomalyEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Anomaly" Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="IsEditable" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="TitleBlock" Text="Edit Anomaly"
                   FontSize="15" FontWeight="SemiBold" Foreground="#333" TextWrapping="Wrap"/>

        <!-- Form -->
        <Grid Grid.Row="2" x:Name="FormGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Job # -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Job #:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="JobNumberBox" Style="{StaticResource Field}"/>

            <!-- Customer -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer:" Style="{StaticResource Label}"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CustomerBox" Style="{StaticResource Combo}"
                       SelectionChanged="CustomerBox_SelectionChanged"/>

            <!-- Contact -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Contact:" Style="{StaticResource Label}"/>
            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="ContactBox" Style="{StaticResource Combo}"/>

            <!-- PO Number -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="PO Number:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="PoNumberBox" Style="{StaticResource Field}"/>

            <!-- OE Number -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="OE Number:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="OeNumberBox" Style="{StaticResource Field}"/>

            <!-- Drawing Number -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Drawing Number:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="DrawingBox" Style="{StaticResource Field}"/>

            <!-- Rev -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Rev:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="RevBox" Style="{StaticResource Field}"/>

            <!-- Description -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Description:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="DescBox" Style="{StaticResource Field}"/>

            <!-- Qty -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Qty:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="8" Grid.Column="1" x:Name="QtyBox" Style="{StaticResource Field}"/>

            <!-- M / Line # -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="M / Line #:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="9" Grid.Column="1" x:Name="LnBox" Style="{StaticResource Field}"/>

            <!-- Price -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Price:" Style="{StaticResource Label}"/>
            <TextBox   Grid.Row="10" Grid.Column="1" x:Name="PriceBox" Style="{StaticResource Field}"/>

            <!-- DWG Release Date -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="DWG Release:" Style="{StaticResource Label}"/>
            <DatePicker Grid.Row="11" Grid.Column="1" x:Name="DwgReleasePicker" Height="28" Margin="0,4"/>

            <!-- Del. Req'd -->
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Del. Req'd:" Style="{StaticResource Label}"/>
            <DatePicker Grid.Row="12" Grid.Column="1" x:Name="DelPicker" Height="28" Margin="0,4"/>
        </Grid>

        <!-- Mark as inactive/shipped -->
        <CheckBox Grid.Row="4" x:Name="ShipCheckBox" Content="Mark as inactive/shipped"
                   FontSize="12" Click="ShipCheckBox_Click"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Update" Width="80" Height="30" Margin="0,0,8,0" IsDefault="True"
                    Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Height="30"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
