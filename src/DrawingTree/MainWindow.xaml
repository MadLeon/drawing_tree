<Window x:Class="DrawingTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingTree"
        mc:Ignorable="d"
        Title="Drawing Tree Manager" Height="800" Width="1200">
    <DockPanel>
        <!-- Toolbar at the top -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Background="#F5F5F5">
            <Border.Resources>
                <Geometry x:Key="SettingsGeo">m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z</Geometry>
                <Style x:Key="GearBtn" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#20000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid Margin="10,8" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="SearchButton"
                            Content="Search"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="SearchButton_Click"/>
                    <Button x:Name="AllPosButton"
                            Content="Order Entry"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="AllPosButton_Click"/>
                    <Button x:Name="ManufacturingScheduleButton"
                            Content="MP Schedule"
                            Width="120"
                            Margin="0,0,10,0"
                            Click="ManufacturingScheduleButton_Click"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GearBtn}"
                        VerticalAlignment="Center"
                        Click="SettingsButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Config" Click="ConfigMenu_Click"/>
                            <MenuItem Header="Run Script" Click="RunScriptMenu_Click"/>
                            <MenuItem Header="OE Sync" Click="OeSyncMenu_Click"/>
                            <MenuItem Header="DIR Log" Click="DirLogMenu_Click"/>
                            <MenuItem Header="Suggestions to Leon" IsEnabled="False"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Data="{StaticResource SettingsGeo}"
                          Stretch="Uniform" Fill="#555555" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main display area -->
        <Grid x:Name="MainDisplayArea" Background="#F5F5F5">
            <!-- Content will be dynamically loaded here -->
        </Grid>
    </DockPanel>
</Window>
